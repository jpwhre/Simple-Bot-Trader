QMainWindow, QDialog { background-color: #1e1e1e; color: #ddd; }
QLabel { color: #ddd; font-size: 13px; }
QPushButton { background: #333; color: #ddd; border: 1px solid #555; padding: 3px 12px; border-radius: 4px; min-height: 16px; }
QPushButton:hover { background: #444; }
QPushButton:pressed { background: #555; }
QTextEdit, QLineEdit { background: #252526; color: #ddd; border: 1px solid #444; border-radius: 3px; spacing: 2px; }
QTextEdit { font-family: "Consolas", "Courier New", monospace; font-size: 13px; }
QDoubleSpinBox, QSpinBox { background: #252526; color: #ddd; border: 1px solid #444; border-radius: 3px; padding: 2px; }
QCheckBox { color: #ddd; spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px; image: url(indicator_unchecked.png); }
QCheckBox::indicator:checked { image: url(indicator_checked_dark.png); }
QFormLayout { spacing: 8px; }
#statusLabel { font-size: 16px; font-weight: bold; color: #00c853; }
#priceLabel { font-size: 18px; font-weight: bold; color: #ffab00; }
#pnlLabel { font-size: 14px; font-weight: bold; }
#connLabel { font-size: 12px; color: #888; }
#positionFrame { background: #2d2d30; border: 1px solid #444; border-radius: 4px; padding: 6px; }
#logArea { background: #1a1a1a; color: #ccc; }
#stopBar { min-height: 20px; background: #333; border-radius: 3px; }
#balanceBar { background: #333; color: #00c853; border: 1px solid #555; border-radius: 4px; font-weight: bold; }
#pnlBar { background: #2d2d30; border: 1px solid #444; border-radius: 4px; }
